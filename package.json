{
  "name": "node-discord-social-sdk",
  "version": "1.0.0",
  "description": "A Node.js addon using CMake and N-API for Discord social SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "install": "cmake-js compile",
    "build": "npm run build:native && npm run build:ts",
    "build:native": "cmake-js compile",
    "build:ts": "tsc",
    "clean": "cmake-js clean",
    "test": "node test/test.js",
    "test:ts": "ts-node test/test.ts"
  },
  "keywords": [
    "native",
    "addon",
    "cmake",
    "napi",
    "discord"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cmake-js": "^7.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
